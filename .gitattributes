# Anything with a shebang must be LF, always. A shell script checked out with
# CRLF on a Windows contributor's machine and committed back fails on Linux with
# "bad interpreter: /bin/sh^M", which reads like a missing shell rather than a
# line-ending problem and costs an hour every time.
*.sh          text eol=lf
*.py          text eol=lf
*.service     text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.jsonc       text eol=lf
*.ts          text eol=lf
*.md          text eol=lf
