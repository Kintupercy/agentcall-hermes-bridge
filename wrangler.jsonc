{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  // A Custom Domain takes a BARE hostname. The "/*" wildcard form is for
  // Worker Routes, and wrangler rejects it here. JSON validity does not catch
  // the difference; only a deploy does.
  "routes": [
    { "pattern": "hermes.YOUR-DOMAIN.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "HERMES_CONTEXT",
      "id": "REPLACE_AFTER_WRANGLER_KV_NAMESPACE_CREATE"
    }
  ]
}
