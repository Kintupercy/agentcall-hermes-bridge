# Secrets for the AgentCall SMS relay consumer.
#
# The installer writes the real version of this file with mode 0600 and points
# systemd at it (EnvironmentFile=). Never commit the real one.
#
# Every value here overrides the same key in config.json.

# The Cloudflare Worker from this repo.
AGENTCALL_BRIDGE_URL=https://hermes.YOUR-DOMAIN.com

# The Worker's HERMES_PUSH_KEY. Authenticates pull-sms / ack-sms.
#   wrangler secret put HERMES_PUSH_KEY
HERMES_PUSH_KEY=

# Your AgentCall API key. Used to read the thread and send the reply.
#   https://agentcall.co/api-keys
AGENTCALL_API_KEY=ac_live_

# The Worker's AGENTCALL_SMS_SIGNING_SECRET (falls back to
# AGENTCALL_SIGNING_SECRET on the Worker side). Only `selftest` and
# `configure-number` need it — the polling loop never does — but keeping it
# here means both work without hunting for it later.
AGENTCALL_SMS_SIGNING_SECRET=

# Comma separated E.164. Overrides allowed_senders in config.json.
# AGENTCALL_ALLOWED_SENDERS=+15551234567
